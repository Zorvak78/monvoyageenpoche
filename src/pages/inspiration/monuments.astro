---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InspirationCard from '../../components/InspirationCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('inspiration')).filter(item => item.data.category === 'monuments');
---

<BaseLayout title="Monuments et sites historiques — Inspiration — Mon Voyage en Poche" description="Temples, pyramides et cités perdues : les sites historiques les plus marquants de nos destinations.">
  <Header />

  <!-- Hero -->
  <section class="relative pt-32 pb-20 bg-deep-teal">
    <div class="absolute inset-0 opacity-20">
      <img
        src="https://images.unsplash.com/photo-1503177119275-0aa32b3a9368?w=1920&q=80"
        alt="Monuments historiques"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-5xl mb-4 block">🏛️</span>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-4">Monuments et sites historiques</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">
        Des temples millénaires aux cités perdues, les traces les plus impressionnantes laissées par les civilisations.
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <section class="bg-white border-b border-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <nav class="text-sm text-slate">
        <a href="/inspiration" class="hover:text-deep-teal transition-colors">Inspiration</a>
        <span class="mx-2">/</span>
        <span class="text-deep-teal font-medium">Monuments et sites historiques</span>
      </nav>
    </div>
  </section>

  <!-- Grid -->
  <section class="py-16 bg-warm-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {items.map(item => (
          <div class="fade-in">
            <InspirationCard
              title={item.data.title}
              location={item.data.location}
              type={item.data.type}
              image={item.data.image}
              description={item.data.description}
              slug={item.id}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
  <Footer />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const allItems = await getCollection('inspiration');

function getCardHeight(index: number): string {
  if (index % 3 === 0) return 'h-80';
  if (index % 3 === 1) return 'h-64';
  return 'h-52';
}

function getCardSize(index: number): string {
  if (index % 3 === 0) return 'large';
  if (index % 3 === 1) return 'medium';
  return 'small';
}
---

<BaseLayout title="Inspiration — Mon Voyage en Poche" description="Trouvez votre prochaine aventure parmi nos lieux, monuments et activités à travers le monde.">
  <Header />

  <!-- Hero -->
  <section class="relative pt-32 pb-16 bg-deep-teal">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=1920&q=80"
        alt="Inspiration voyage"
        class="w-full h-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-deep-teal/60 via-deep-teal/40 to-deep-teal"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-4">
        Trouvez votre prochaine aventure
      </h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">
        Explorez les plus beaux lieux du monde. Cliquez, découvrez, et partez.
      </p>
    </div>
  </section>

  <!-- Sticky Filter Bar -->
  <section class="bg-white/95 backdrop-blur-sm border-b border-cream sticky top-20 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex items-center gap-3 overflow-x-auto filter-scroll" style="scrollbar-width: none; -ms-overflow-style: none;">
        <!-- All button -->
        <button
          data-filter-type="all"
          data-filter-value="all"
          class="filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-amber text-white"
        >
          Tout
        </button>

        <!-- Separator -->
        <span class="shrink-0 w-px h-6 bg-charcoal/20"></span>

        <!-- Country filters -->
        <button data-filter-type="country" data-filter-value="perou" class="filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-cream text-charcoal hover:bg-amber/20">Pérou</button>
        <button data-filter-type="country" data-filter-value="italie" class="filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-cream text-charcoal hover:bg-amber/20">Italie</button>
        <button data-filter-type="country" data-filter-value="namibie" class="filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-cream text-charcoal hover:bg-amber/20">Namibie</button>

        <!-- Separator -->
        <span class="shrink-0 w-px h-6 bg-charcoal/20"></span>

        <!-- Category filters -->
        <button data-filter-type="category" data-filter-value="nature" class="filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-cream text-charcoal hover:bg-amber/20">Nature</button>
        <button data-filter-type="category" data-filter-value="monuments" class="filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-cream text-charcoal hover:bg-amber/20">Monuments</button>
        <button data-filter-type="category" data-filter-value="activites" class="filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-cream text-charcoal hover:bg-amber/20">Activités</button>
      </div>
    </div>
  </section>

  <!-- Mosaic Grid -->
  <section class="py-12 bg-warm-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="columns-2 md:columns-3 lg:columns-4 gap-4">
        {allItems.map((item, index) => (
          <div
            class="flip-card break-inside-avoid mb-4"
            data-country={item.data.country}
            data-category={item.data.category}
            data-size={getCardSize(index)}
          >
            <div class={`flip-card-inner ${getCardHeight(index)}`}>
              <!-- FACE AVANT -->
              <div class="flip-card-front rounded-2xl overflow-hidden">
                <img
                  src={item.data.image}
                  alt={item.data.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent rounded-2xl"></div>
                <div class="absolute bottom-4 left-4 right-4 z-10">
                  <span class="text-amber text-xs font-semibold uppercase tracking-wider">{item.data.type}</span>
                  <h3 class="font-display text-lg font-bold text-white mt-1">{item.data.title}</h3>
                  <p class="text-white/70 text-sm">{item.data.location}</p>
                </div>
              </div>
              <!-- FACE ARRIÈRE -->
              <div class="flip-card-back bg-deep-teal rounded-2xl p-4 sm:p-5 flex flex-col overflow-hidden">
                <div class="flex-1 min-h-0 overflow-hidden">
                  <span class="text-amber text-xs font-semibold uppercase tracking-wider">{item.data.type}</span>
                  <h3 class="font-display text-lg font-bold text-white mt-1 mb-1 line-clamp-1">{item.data.title}</h3>
                  <p class="text-white/70 text-xs mb-1">{item.data.location}</p>
                  <p class="text-white/80 text-sm leading-relaxed line-clamp-3">{item.data.description}</p>
                </div>
                <a href={`/voyager/${item.data.country}`} class="mt-3 shrink-0 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-amber hover:bg-gold text-white font-semibold rounded-xl transition-colors text-sm">
                  Voyager vers ce lieu →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
  <Footer />
</BaseLayout>

<style>
  .filter-scroll::-webkit-scrollbar {
    display: none;
  }

  .flip-card {
    perspective: 1000px;
    cursor: pointer;
  }

  .flip-card-inner {
    position: relative;
    transition: transform 0.6s;
    transform-style: preserve-3d;
  }

  .flip-card.flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-card-front {
    z-index: 2;
  }

  .flip-card-back {
    transform: rotateY(180deg);
    z-index: 1;
  }

  .flip-card[data-size="small"] .flip-card-back p:last-of-type {
    -webkit-line-clamp: 2;
  }
  .flip-card[data-size="small"] .flip-card-back {
    padding: 0.75rem;
  }
  .flip-card[data-size="small"] .flip-card-back h3 {
    font-size: 1rem;
  }
  .flip-card[data-size="medium"] .flip-card-back p:last-of-type {
    -webkit-line-clamp: 2;
  }
</style>

<script>
  // Flip cards - toggle on click
  document.querySelectorAll('.flip-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      card.classList.toggle('flipped');
    });
  });

  // Filtering
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.flip-card');
  let activeCountry: string | null = null;
  let activeCategory: string | null = null;

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.filterType!;
      const value = btn.dataset.filterValue!;

      if (value === 'all') {
        activeCountry = null;
        activeCategory = null;
      } else if (type === 'country') {
        activeCountry = activeCountry === value ? null : value;
      } else if (type === 'category') {
        activeCategory = activeCategory === value ? null : value;
      }

      // Update button states
      filterBtns.forEach(b => {
        const bType = b.dataset.filterType!;
        const bValue = b.dataset.filterValue!;
        let isActive = false;
        if (bValue === 'all' && !activeCountry && !activeCategory) isActive = true;
        if (bType === 'country' && bValue === activeCountry) isActive = true;
        if (bType === 'category' && bValue === activeCategory) isActive = true;

        b.classList.toggle('bg-amber', isActive);
        b.classList.toggle('text-white', isActive);
        b.classList.toggle('bg-cream', !isActive);
        b.classList.toggle('text-charcoal', !isActive);
      });

      // Filter cards
      cards.forEach(card => {
        const country = card.dataset.country;
        const category = card.dataset.category;
        const matchCountry = !activeCountry || country === activeCountry;
        const matchCategory = !activeCategory || category === activeCategory;

        if (matchCountry && matchCategory) {
          card.style.display = '';
          requestAnimationFrame(() => {
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
          });
        } else {
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          setTimeout(() => { card.style.display = 'none'; }, 300);
        }
      });
    });
  });
</script>

---
// Standalone escape game - London Weekend Surprise Reveal
---
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mission Secrète</title>
    <link rel="icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg-dark: #0a0a0f;
            --bg-card: #14141f;
            --bg-card-hover: #1a1a2e;
            --gold: #d4a03c;
            --gold-light: #f0d080;
            --gold-dark: #b8860b;
            --red: #c0392b;
            --green: #27ae60;
            --text: #e8e6e1;
            --text-muted: #8a8a9a;
            --font-display: 'Playfair Display', serif;
            --font-body: 'Inter', sans-serif;
        }

        body {
            font-family: var(--font-body);
            background: var(--bg-dark);
            color: var(--text);
            min-height: 100dvh;
            overflow-x: hidden;
        }

        /* Background ambiance */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse at 20% 50%, rgba(212,160,60,0.06) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 20%, rgba(212,160,60,0.04) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 80%, rgba(100,100,180,0.04) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        .screen {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100dvh;
            padding: 2rem 1.5rem;
            position: relative;
            z-index: 1;
            animation: fadeIn 0.6s ease-out;
        }

        .screen.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }

        @keyframes unlockBounce {
            0% { transform: scale(1); }
            30% { transform: scale(1.2); }
            50% { transform: scale(0.95); }
            70% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        @keyframes revealScale {
            0% { transform: scale(0.3); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes confettiFall {
            0% { transform: translateY(-100vh) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Progress bar */
        .progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: rgba(255,255,255,0.05);
            z-index: 100;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--gold-dark), var(--gold), var(--gold-light));
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 0 2px 2px 0;
        }

        .step-indicators {
            position: fixed;
            top: 20px;
            right: 20px;
            display: flex;
            gap: 8px;
            z-index: 100;
        }

        .step-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid var(--gold-dark);
            background: transparent;
            transition: all 0.3s ease;
        }

        .step-dot.completed {
            background: var(--gold);
            border-color: var(--gold);
            box-shadow: 0 0 8px rgba(212,160,60,0.5);
        }

        .step-dot.current {
            border-color: var(--gold-light);
            animation: pulse 2s infinite;
        }

        /* Card container */
        .card {
            background: var(--bg-card);
            border: 1px solid rgba(212,160,60,0.15);
            border-radius: 20px;
            padding: 2.5rem 2rem;
            max-width: 520px;
            width: 100%;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }

        .card-icon {
            font-size: 3.5rem;
            margin-bottom: 1.5rem;
            display: block;
            animation: float 3s ease-in-out infinite;
        }

        h1 {
            font-family: var(--font-display);
            font-size: 2.2rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--gold-light), var(--gold), var(--gold-dark));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            line-height: 1.2;
        }

        h2 {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--gold);
            margin-bottom: 1rem;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .enigme-label {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: var(--gold-dark);
            margin-bottom: 1rem;
            padding: 4px 12px;
            border: 1px solid rgba(212,160,60,0.2);
            border-radius: 20px;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 36px;
            border: none;
            border-radius: 12px;
            font-family: var(--font-body);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--gold-dark), var(--gold));
            color: var(--bg-dark);
            box-shadow: 0 4px 15px rgba(212,160,60,0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212,160,60,0.4);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-secondary {
            background: rgba(212,160,60,0.1);
            color: var(--gold);
            border: 1px solid rgba(212,160,60,0.3);
        }

        .btn-secondary:hover {
            background: rgba(212,160,60,0.2);
        }

        .btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
        }

        /* Code Lock (Enigme 1) */
        .riddles {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-bottom: 1.5rem;
            text-align: left;
        }

        .riddle-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: rgba(255,255,255,0.03);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .riddle-number {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(212,160,60,0.15);
            color: var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .riddle-text {
            flex: 1;
            font-size: 0.9rem;
            color: var(--text-muted);
            line-height: 1.4;
        }

        .riddle-input {
            width: 48px;
            height: 48px;
            text-align: center;
            font-size: 1.4rem;
            font-weight: 700;
            font-family: var(--font-body);
            background: var(--bg-dark);
            border: 2px solid rgba(212,160,60,0.3);
            border-radius: 10px;
            color: var(--gold-light);
            outline: none;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .riddle-input:focus {
            border-color: var(--gold);
            box-shadow: 0 0 12px rgba(212,160,60,0.2);
        }

        .riddle-input.correct {
            border-color: var(--green);
            background: rgba(39,174,96,0.1);
            color: var(--green);
        }

        .riddle-input.wrong {
            border-color: var(--red);
            animation: shake 0.4s ease;
        }

        /* Clues grid (Enigme 2) */
        .clues-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 1.5rem;
        }

        .clue-card {
            padding: 16px 12px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 14px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .clue-card.revealed {
            border-color: rgba(212,160,60,0.3);
            background: rgba(212,160,60,0.05);
        }

        .clue-icon {
            font-size: 2rem;
            display: block;
            margin-bottom: 6px;
        }

        .clue-text {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.3;
        }

        .clue-card:nth-child(5) {
            grid-column: 1 / -1;
        }

        /* Text input */
        .text-input-group {
            display: flex;
            gap: 10px;
            margin-bottom: 1rem;
            width: 100%;
            max-width: 360px;
        }

        .text-input {
            flex: 1;
            padding: 12px 18px;
            font-size: 1.1rem;
            font-family: var(--font-body);
            font-weight: 600;
            background: var(--bg-dark);
            border: 2px solid rgba(212,160,60,0.3);
            border-radius: 12px;
            color: var(--text);
            outline: none;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s;
            text-align: center;
        }

        .text-input:focus {
            border-color: var(--gold);
            box-shadow: 0 0 15px rgba(212,160,60,0.15);
        }

        .text-input.correct {
            border-color: var(--green);
            color: var(--green);
        }

        .text-input.wrong {
            border-color: var(--red);
            animation: shake 0.4s ease;
        }

        /* Anagram (Enigme 3) */
        .anagram-letters {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .letter-tile {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            font-weight: 700;
            font-family: var(--font-display);
            background: var(--bg-dark);
            border: 2px solid rgba(212,160,60,0.3);
            border-radius: 10px;
            color: var(--gold-light);
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
        }

        .letter-tile:hover:not(.used) {
            border-color: var(--gold);
            transform: translateY(-3px);
            box-shadow: 0 4px 12px rgba(212,160,60,0.2);
        }

        .letter-tile.used {
            opacity: 0.2;
            cursor: default;
            transform: scale(0.9);
        }

        .answer-slots {
            display: flex;
            gap: 8px;
            justify-content: center;
            margin-bottom: 1.5rem;
            min-height: 52px;
        }

        .answer-slot {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            font-weight: 700;
            font-family: var(--font-display);
            background: rgba(212,160,60,0.05);
            border: 2px dashed rgba(212,160,60,0.2);
            border-radius: 10px;
            color: var(--gold);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .answer-slot.filled {
            border-style: solid;
            border-color: rgba(212,160,60,0.4);
            background: rgba(212,160,60,0.1);
            animation: unlockBounce 0.3s ease;
        }

        .answer-slot.correct-letter {
            border-color: var(--green);
            color: var(--green);
            background: rgba(39,174,96,0.1);
        }

        /* Word order (Enigme 4) */
        .word-bank {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .word-chip {
            padding: 10px 18px;
            background: var(--bg-dark);
            border: 2px solid rgba(212,160,60,0.3);
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            color: var(--gold-light);
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
        }

        .word-chip:hover:not(.used) {
            border-color: var(--gold);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(212,160,60,0.2);
        }

        .word-chip.used {
            opacity: 0.2;
            cursor: default;
        }

        .sentence-area {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: center;
            align-items: center;
            min-height: 50px;
            padding: 16px;
            background: rgba(255,255,255,0.02);
            border: 2px dashed rgba(212,160,60,0.15);
            border-radius: 14px;
            margin-bottom: 1.5rem;
        }

        .placed-word {
            padding: 8px 14px;
            background: rgba(212,160,60,0.1);
            border: 1px solid rgba(212,160,60,0.3);
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            color: var(--gold);
            cursor: pointer;
            animation: unlockBounce 0.3s ease;
        }

        .sentence-placeholder {
            color: var(--text-muted);
            font-size: 0.85rem;
            font-style: italic;
        }

        /* Feedback */
        .feedback {
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 500;
            margin-top: 1rem;
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .feedback.error {
            display: block;
            background: rgba(192,57,43,0.1);
            color: #e74c3c;
            border: 1px solid rgba(192,57,43,0.2);
        }

        .feedback.success {
            display: block;
            background: rgba(39,174,96,0.1);
            color: #2ecc71;
            border: 1px solid rgba(39,174,96,0.2);
        }

        .hint-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 0.8rem;
            cursor: pointer;
            padding: 8px;
            margin-top: 0.5rem;
            text-decoration: underline;
            text-underline-offset: 3px;
            font-family: var(--font-body);
        }

        .hint-btn:hover { color: var(--gold); }

        .hint-text {
            font-size: 0.85rem;
            color: var(--gold-dark);
            margin-top: 0.5rem;
            font-style: italic;
            display: none;
        }

        .hint-text.visible { display: block; }

        /* Final reveal */
        .reveal-container {
            text-align: center;
            max-width: 600px;
        }

        .reveal-icon {
            font-size: 5rem;
            display: block;
            margin-bottom: 1rem;
            animation: revealScale 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .reveal-title {
            font-family: var(--font-display);
            font-size: 2.8rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--gold-light), var(--gold), var(--gold-dark));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            line-height: 1.2;
            animation: slideUp 0.8s ease 0.3s both;
        }

        .reveal-destination {
            font-family: var(--font-display);
            font-size: 4rem;
            font-weight: 900;
            color: #fff;
            text-shadow: 0 0 40px rgba(212,160,60,0.5), 0 0 80px rgba(212,160,60,0.2);
            margin: 1rem 0;
            animation: revealScale 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s both;
        }

        .reveal-subtitle {
            font-size: 1.3rem;
            color: var(--text-muted);
            animation: slideUp 0.6s ease 1s both;
        }

        .reveal-emoji-row {
            font-size: 2.5rem;
            margin: 1.5rem 0;
            animation: slideUp 0.6s ease 1.3s both;
            display: flex;
            justify-content: center;
            gap: 16px;
        }

        .reveal-emoji-row span {
            animation: float 2s ease-in-out infinite;
        }

        .reveal-emoji-row span:nth-child(2) { animation-delay: 0.3s; }
        .reveal-emoji-row span:nth-child(3) { animation-delay: 0.6s; }
        .reveal-emoji-row span:nth-child(4) { animation-delay: 0.9s; }
        .reveal-emoji-row span:nth-child(5) { animation-delay: 1.2s; }

        /* Confetti */
        .confetti-container {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 1000;
            overflow: hidden;
        }

        .confetti-piece {
            position: absolute;
            top: -20px;
            width: 10px;
            height: 10px;
            animation: confettiFall linear forwards;
        }

        /* Responsive */
        @media (max-width: 480px) {
            .card { padding: 2rem 1.2rem; }
            h1 { font-size: 1.7rem; }
            h2 { font-size: 1.2rem; }
            .riddle-row { flex-wrap: wrap; justify-content: center; }
            .riddle-text { text-align: center; }
            .clues-grid { grid-template-columns: 1fr; }
            .clue-card:nth-child(5) { grid-column: auto; }
            .letter-tile, .answer-slot { width: 40px; height: 40px; font-size: 1.2rem; }
            .reveal-title { font-size: 2rem; }
            .reveal-destination { font-size: 2.8rem; }
        }
    </style>
</head>
<body>

    <!-- Progress -->
    <div class="progress-bar">
        <div class="progress-fill" id="progressFill" style="width: 0%"></div>
    </div>
    <div class="step-indicators" id="stepIndicators" style="display:none">
        <div class="step-dot" data-step="1"></div>
        <div class="step-dot" data-step="2"></div>
        <div class="step-dot" data-step="3"></div>
        <div class="step-dot" data-step="4"></div>
    </div>

    <!-- INTRO -->
    <div class="screen active" id="intro">
        <div class="card">
            <span class="card-icon">🔒</span>
            <h1>Mission Secrète</h1>
            <p class="subtitle">
                Un mystérieux message a été intercepté.<br>
                Résolvez les 4 énigmes pour découvrir<br>
                le secret qui vous attend...
            </p>
            <button class="btn btn-primary" id="startBtn">
                Accepter la mission
            </button>
        </div>
    </div>

    <!-- ENIGME 1 : Le Cadenas -->
    <div class="screen" id="enigme1">
        <div class="card">
            <span class="enigme-label">Enigme 1 / 4</span>
            <span class="card-icon">🔐</span>
            <h2>Le Cadenas</h2>
            <p class="subtitle">Trouvez le code à 3 chiffres en résolvant ces indices.</p>

            <div class="riddles">
                <div class="riddle-row">
                    <span class="riddle-number">1</span>
                    <span class="riddle-text">Combien de couleurs composent le drapeau du Royaume-Uni ?</span>
                    <input type="number" class="riddle-input" id="digit1" min="0" max="9" maxlength="1">
                </div>
                <div class="riddle-row">
                    <span class="riddle-number">2</span>
                    <span class="riddle-text">Combien de musiciens composaient les Beatles ?</span>
                    <input type="number" class="riddle-input" id="digit2" min="0" max="9" maxlength="1">
                </div>
                <div class="riddle-row">
                    <span class="riddle-number">3</span>
                    <span class="riddle-text">Combien de lettres dans le mot "QUEEN" ?</span>
                    <input type="number" class="riddle-input" id="digit3" min="0" max="9" maxlength="1">
                </div>
            </div>

            <button class="btn btn-primary" id="checkCode">Déverrouiller</button>
            <div class="feedback" id="feedback1"></div>
            <button class="hint-btn" id="hint1Btn">Besoin d'un indice ?</button>
            <p class="hint-text" id="hint1Text">Pensez à l'Union Jack, à Abbey Road, et à Bohemian Rhapsody...</p>
        </div>
    </div>

    <!-- ENIGME 2 : Le Détective -->
    <div class="screen" id="enigme2">
        <div class="card">
            <span class="enigme-label">Enigme 2 / 4</span>
            <span class="card-icon">🔍</span>
            <h2>Le Détective</h2>
            <p class="subtitle">Quel pays relie tous ces indices ?</p>

            <div class="clues-grid">
                <div class="clue-card" id="clue1">
                    <span class="clue-icon">🫖</span>
                    <span class="clue-text">Le thé de 17h est sacré</span>
                </div>
                <div class="clue-card" id="clue2">
                    <span class="clue-icon">🚌</span>
                    <span class="clue-text">Des bus rouges à deux étages</span>
                </div>
                <div class="clue-card" id="clue3">
                    <span class="clue-icon">👑</span>
                    <span class="clue-text">God Save the King</span>
                </div>
                <div class="clue-card" id="clue4">
                    <span class="clue-icon">🌧️</span>
                    <span class="clue-text">La pluie est une vieille amie</span>
                </div>
                <div class="clue-card" id="clue5">
                    <span class="clue-icon">⚽</span>
                    <span class="clue-text">Le berceau du football</span>
                </div>
            </div>

            <div class="text-input-group" style="margin: 0 auto;">
                <input type="text" class="text-input" id="countryInput" placeholder="_ _ _ _ _ _ _ _ _ _" autocomplete="off" spellcheck="false">
            </div>
            <br>
            <button class="btn btn-primary" id="checkCountry">Valider</button>
            <div class="feedback" id="feedback2"></div>
            <button class="hint-btn" id="hint2Btn">Besoin d'un indice ?</button>
            <p class="hint-text" id="hint2Text">C'est un pays européen insulaire, voisin de l'Écosse...</p>
        </div>
    </div>

    <!-- ENIGME 3 : L'Anagramme -->
    <div class="screen" id="enigme3">
        <div class="card">
            <span class="enigme-label">Enigme 3 / 4</span>
            <span class="card-icon">🧩</span>
            <h2>L'Anagramme</h2>
            <p class="subtitle">Réorganisez ces lettres pour trouver une capitale européenne.</p>

            <div class="anagram-letters" id="letterBank">
                <!-- Letters filled by JS -->
            </div>

            <div class="answer-slots" id="answerSlots">
                <!-- Slots filled by JS -->
            </div>

            <div style="display: flex; gap: 10px; justify-content: center;">
                <button class="btn btn-secondary" id="resetAnagram">Effacer</button>
                <button class="btn btn-primary" id="checkAnagram">Valider</button>
            </div>
            <div class="feedback" id="feedback3"></div>
            <button class="hint-btn" id="hint3Btn">Besoin d'un indice ?</button>
            <p class="hint-text" id="hint3Text">Cette ville est traversée par la Tamise...</p>
        </div>
    </div>

    <!-- ENIGME 4 : Le Message -->
    <div class="screen" id="enigme4">
        <div class="card">
            <span class="enigme-label">Enigme 4 / 4</span>
            <span class="card-icon">✉️</span>
            <h2>Le Message Secret</h2>
            <p class="subtitle">Remettez les mots dans l'ordre pour révéler le message final !</p>

            <div class="word-bank" id="wordBank">
                <!-- Words filled by JS -->
            </div>

            <div class="sentence-area" id="sentenceArea">
                <span class="sentence-placeholder" id="sentencePlaceholder">Cliquez sur les mots dans le bon ordre...</span>
            </div>

            <div style="display: flex; gap: 10px; justify-content: center;">
                <button class="btn btn-secondary" id="resetSentence">Effacer</button>
                <button class="btn btn-primary" id="checkSentence">Valider</button>
            </div>
            <div class="feedback" id="feedback4"></div>
        </div>
    </div>

    <!-- FINAL REVEAL -->
    <div class="screen" id="reveal">
        <div class="reveal-container">
            <span class="reveal-icon">🎉</span>
            <div class="reveal-title">Surprise !</div>
            <div class="reveal-destination">LONDRES</div>
            <div class="reveal-subtitle">Vous partez en week-end !</div>
            <div class="reveal-emoji-row">
                <span>🇬🇧</span>
                <span>🎡</span>
                <span>🏰</span>
                <span>☕</span>
                <span>❤️</span>
            </div>
        </div>
        <div class="confetti-container" id="confettiContainer"></div>
    </div>

    <script>
        const screens = ['intro', 'enigme1', 'enigme2', 'enigme3', 'enigme4', 'reveal'];
        let currentScreen = 0;
        let completedSteps = 0;

        function showScreen(index) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            const screen = document.getElementById(screens[index]);
            screen.classList.add('active');
            screen.style.animation = 'none';
            screen.offsetHeight;
            screen.style.animation = '';
            currentScreen = index;

            const indicators = document.getElementById('stepIndicators');
            if (index > 0 && index < 5) {
                indicators.style.display = 'flex';
                document.querySelectorAll('.step-dot').forEach((dot, i) => {
                    dot.classList.remove('current', 'completed');
                    if (i < index - 1) dot.classList.add('completed');
                    else if (i === index - 1) dot.classList.add('current');
                });
            } else {
                indicators.style.display = 'none';
            }

            document.getElementById('progressFill').style.width = `${(index / 5) * 100}%`;
        }

        function showFeedback(id, message, type) {
            const fb = document.getElementById(id);
            fb.className = `feedback ${type}`;
            fb.textContent = message;
            fb.style.display = 'block';
        }

        function clearFeedback(id) {
            const fb = document.getElementById(id);
            fb.style.display = 'none';
        }

        // INTRO
        document.getElementById('startBtn').addEventListener('click', () => showScreen(1));

        // ENIGME 1 - Le Cadenas
        const correctCode = [3, 4, 5]; // UK flag colors, Beatles members, QUEEN letters

        document.querySelectorAll('.riddle-input').forEach((input, i) => {
            input.addEventListener('input', (e) => {
                const val = e.target.value;
                if (val.length > 1) e.target.value = val.slice(-1);
                if (val !== '') {
                    const next = document.getElementById(`digit${i + 2}`);
                    if (next) next.focus();
                }
            });
        });

        document.getElementById('checkCode').addEventListener('click', () => {
            const d1 = parseInt(document.getElementById('digit1').value);
            const d2 = parseInt(document.getElementById('digit2').value);
            const d3 = parseInt(document.getElementById('digit3').value);

            clearFeedback('feedback1');

            let allCorrect = true;
            [d1, d2, d3].forEach((val, i) => {
                const input = document.getElementById(`digit${i + 1}`);
                input.classList.remove('correct', 'wrong');
                if (val === correctCode[i]) {
                    input.classList.add('correct');
                } else {
                    input.classList.add('wrong');
                    allCorrect = false;
                }
            });

            if (allCorrect) {
                showFeedback('feedback1', 'Le cadenas s\'ouvre ! Premier indice déverrouillé.', 'success');
                completedSteps++;
                setTimeout(() => showScreen(2), 1500);
            } else {
                showFeedback('feedback1', 'Code incorrect... Réessayez !', 'error');
            }
        });

        document.getElementById('hint1Btn').addEventListener('click', () => {
            document.getElementById('hint1Text').classList.toggle('visible');
        });

        // ENIGME 2 - Le Détective
        const validAnswers2 = ['angleterre', 'england', 'l\'angleterre'];

        // Reveal clues one by one
        let clueIndex = 0;
        function revealClues() {
            const clues = document.querySelectorAll('.clue-card');
            clues.forEach((c, i) => {
                setTimeout(() => c.classList.add('revealed'), i * 300);
            });
        }

        const observer = new MutationObserver(() => {
            if (document.getElementById('enigme2').classList.contains('active')) {
                revealClues();
                observer.disconnect();
            }
        });
        observer.observe(document.getElementById('enigme2'), { attributes: true });

        document.getElementById('countryInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') document.getElementById('checkCountry').click();
        });

        document.getElementById('checkCountry').addEventListener('click', () => {
            const input = document.getElementById('countryInput');
            const val = input.value.trim().toLowerCase().replace(/['']/g, "'");
            clearFeedback('feedback2');
            input.classList.remove('correct', 'wrong');

            if (validAnswers2.includes(val)) {
                input.classList.add('correct');
                showFeedback('feedback2', 'Exactement ! L\'Angleterre, bien vu !', 'success');
                completedSteps++;
                setTimeout(() => showScreen(3), 1500);
            } else {
                input.classList.add('wrong');
                setTimeout(() => input.classList.remove('wrong'), 400);
                showFeedback('feedback2', 'Ce n\'est pas ça... Relisez les indices !', 'error');
            }
        });

        document.getElementById('hint2Btn').addEventListener('click', () => {
            document.getElementById('hint2Text').classList.toggle('visible');
        });

        // ENIGME 3 - L'Anagramme
        const targetWord = 'LONDRES';
        const shuffledLetters = 'LONDRES'.split('').sort(() => Math.random() - 0.5);
        let selectedLetters = [];

        function initAnagram() {
            const bank = document.getElementById('letterBank');
            const slots = document.getElementById('answerSlots');
            bank.innerHTML = '';
            slots.innerHTML = '';
            selectedLetters = [];

            shuffledLetters.forEach((letter, i) => {
                const tile = document.createElement('div');
                tile.className = 'letter-tile';
                tile.textContent = letter;
                tile.dataset.index = i;
                tile.addEventListener('click', () => selectLetter(i));
                bank.appendChild(tile);
            });

            for (let i = 0; i < targetWord.length; i++) {
                const slot = document.createElement('div');
                slot.className = 'answer-slot';
                slot.dataset.pos = i;
                slot.addEventListener('click', () => removeFromSlot(i));
                slots.appendChild(slot);
            }
        }

        function selectLetter(index) {
            if (selectedLetters.length >= targetWord.length) return;
            const tile = document.querySelector(`.letter-tile[data-index="${index}"]`);
            if (tile.classList.contains('used')) return;

            tile.classList.add('used');
            const pos = selectedLetters.length;
            selectedLetters.push({ index, letter: shuffledLetters[index] });

            const slot = document.querySelector(`.answer-slot[data-pos="${pos}"]`);
            slot.textContent = shuffledLetters[index];
            slot.classList.add('filled');
        }

        function removeFromSlot(pos) {
            if (pos >= selectedLetters.length) return;
            const removed = selectedLetters.splice(pos);
            removed.forEach(item => {
                const tile = document.querySelector(`.letter-tile[data-index="${item.index}"]`);
                tile.classList.remove('used');
            });

            document.querySelectorAll('.answer-slot').forEach((slot, i) => {
                if (i < selectedLetters.length) {
                    slot.textContent = selectedLetters[i].letter;
                    slot.classList.add('filled');
                } else {
                    slot.textContent = '';
                    slot.classList.remove('filled', 'correct-letter');
                }
            });
        }

        document.getElementById('resetAnagram').addEventListener('click', () => {
            clearFeedback('feedback3');
            selectedLetters = [];
            document.querySelectorAll('.letter-tile').forEach(t => t.classList.remove('used'));
            document.querySelectorAll('.answer-slot').forEach(s => {
                s.textContent = '';
                s.classList.remove('filled', 'correct-letter');
            });
        });

        document.getElementById('checkAnagram').addEventListener('click', () => {
            clearFeedback('feedback3');
            const attempt = selectedLetters.map(s => s.letter).join('');

            if (attempt.length < targetWord.length) {
                showFeedback('feedback3', 'Placez toutes les lettres d\'abord !', 'error');
                return;
            }

            if (attempt === targetWord) {
                document.querySelectorAll('.answer-slot').forEach(s => s.classList.add('correct-letter'));
                showFeedback('feedback3', 'LONDRES ! La destination se précise...', 'success');
                completedSteps++;
                setTimeout(() => showScreen(4), 1500);
            } else {
                showFeedback('feedback3', 'Ce n\'est pas le bon ordre... Réessayez !', 'error');
                document.querySelectorAll('.answer-slot').forEach(s => {
                    s.style.animation = 'shake 0.4s ease';
                    setTimeout(() => s.style.animation = '', 400);
                });
            }
        });

        document.getElementById('hint3Btn').addEventListener('click', () => {
            document.getElementById('hint3Text').classList.toggle('visible');
        });

        initAnagram();

        // ENIGME 4 - Le Message Secret
        const correctSentence = ['VOUS', 'PARTEZ', 'EN', 'WEEK-END', 'À', 'LONDRES', '!'];
        const shuffledWords = [...correctSentence].sort(() => Math.random() - 0.5);
        let placedWords = [];

        function initSentence() {
            const bank = document.getElementById('wordBank');
            bank.innerHTML = '';
            placedWords = [];

            shuffledWords.forEach((word, i) => {
                const chip = document.createElement('div');
                chip.className = 'word-chip';
                chip.textContent = word;
                chip.dataset.index = i;
                chip.addEventListener('click', () => placeWord(i));
                bank.appendChild(chip);
            });

            updateSentenceDisplay();
        }

        function placeWord(index) {
            const chip = document.querySelector(`.word-chip[data-index="${index}"]`);
            if (chip.classList.contains('used')) return;
            chip.classList.add('used');
            placedWords.push({ index, word: shuffledWords[index] });
            updateSentenceDisplay();
        }

        function updateSentenceDisplay() {
            const area = document.getElementById('sentenceArea');
            area.innerHTML = '';

            if (placedWords.length === 0) {
                const ph = document.createElement('span');
                ph.className = 'sentence-placeholder';
                ph.textContent = 'Cliquez sur les mots dans le bon ordre...';
                area.appendChild(ph);
                return;
            }

            placedWords.forEach((item, i) => {
                const el = document.createElement('div');
                el.className = 'placed-word';
                el.textContent = item.word;
                el.addEventListener('click', () => removeWord(i));
                area.appendChild(el);
            });
        }

        function removeWord(pos) {
            const removed = placedWords.splice(pos);
            removed.forEach(item => {
                const chip = document.querySelector(`.word-chip[data-index="${item.index}"]`);
                chip.classList.remove('used');
            });
            updateSentenceDisplay();
        }

        document.getElementById('resetSentence').addEventListener('click', () => {
            clearFeedback('feedback4');
            placedWords = [];
            document.querySelectorAll('.word-chip').forEach(c => c.classList.remove('used'));
            updateSentenceDisplay();
        });

        document.getElementById('checkSentence').addEventListener('click', () => {
            clearFeedback('feedback4');
            const attempt = placedWords.map(p => p.word);

            if (attempt.length < correctSentence.length) {
                showFeedback('feedback4', 'Placez tous les mots pour former la phrase !', 'error');
                return;
            }

            const isCorrect = attempt.every((w, i) => w === correctSentence[i]);

            if (isCorrect) {
                showFeedback('feedback4', 'Le message est déchiffré !', 'success');
                completedSteps++;
                setTimeout(() => {
                    showScreen(5);
                    launchConfetti();
                }, 1500);
            } else {
                showFeedback('feedback4', 'L\'ordre n\'est pas correct... Réessayez !', 'error');
            }
        });

        initSentence();

        // CONFETTI
        function launchConfetti() {
            const container = document.getElementById('confettiContainer');
            const colors = ['#d4a03c', '#f0d080', '#e74c3c', '#3498db', '#2ecc71', '#9b59b6', '#fff'];

            for (let i = 0; i < 120; i++) {
                const piece = document.createElement('div');
                piece.className = 'confetti-piece';
                const color = colors[Math.floor(Math.random() * colors.length)];
                const size = Math.random() * 10 + 6;
                const isCircle = Math.random() > 0.5;
                piece.style.left = Math.random() * 100 + '%';
                piece.style.width = size + 'px';
                piece.style.height = isCircle ? size + 'px' : size * 2.5 + 'px';
                piece.style.background = color;
                piece.style.borderRadius = isCircle ? '50%' : '3px';
                piece.style.animationDuration = (Math.random() * 2 + 2) + 's';
                piece.style.animationDelay = Math.random() * 1.5 + 's';
                container.appendChild(piece);
            }

            setTimeout(() => { container.innerHTML = ''; }, 5000);
        }
    </script>

</body>
</html>

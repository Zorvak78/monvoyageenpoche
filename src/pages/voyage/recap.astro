---
import FunnelLayout from '../../layouts/FunnelLayout.astro';
import { getCollection } from 'astro:content';

const lieux = await getCollection('lieux');
const lieuxData = lieux.map(l => ({
  slug: l.id.replace(/^[^/]+\//, '').replace(/\.md$/, ''),
  ...l.data,
}));
---

<FunnelLayout
  title="Récap de ton voyage | Mon Voyage en Poche"
  description="Le récap complet de ton voyage avec carte, budget total, partage et envoi par email."
  step="recap"
>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <header class="mb-8">
      <p class="font-display italic text-amber mb-1">Ton voyage</p>
      <h1 id="recap-title" class="font-display text-3xl md:text-5xl font-bold text-deep-teal mb-2">Ton voyage</h1>
      <p id="recap-subtitle" class="text-slate"></p>
    </header>

    <div id="no-trip" class="hidden bg-cream rounded-2xl p-8 text-center">
      <h2 class="font-display text-xl font-bold text-deep-teal mb-2">Pas encore de voyage</h2>
      <p class="text-slate mb-4">Construis ton voyage en quatre étapes pour voir le récap ici.</p>
      <a href="/voyage/destination" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-deep-teal text-white font-semibold hover:bg-amber hover:text-charcoal transition-all">
        Commencer
      </a>
    </div>

    <div id="recap-content" class="hidden space-y-8">
      <!-- Map -->
      <section class="bg-white rounded-2xl border border-cream shadow-sm overflow-hidden">
        <div id="map" class="w-full h-[360px] md:h-[420px]"></div>
      </section>

      <!-- Itinéraire détaillé -->
      <section class="bg-white rounded-2xl border border-cream shadow-sm p-6 md:p-8">
        <h2 class="font-display text-xl font-bold text-deep-teal mb-4">Ton parcours en détail</h2>
        <ol id="recap-steps" class="space-y-3"></ol>
      </section>

      <!-- Carnet de réservations -->
      <section class="bg-white rounded-2xl border border-cream shadow-sm p-6 md:p-8">
        <div class="flex items-baseline justify-between gap-4 mb-3">
          <h2 class="font-display text-xl font-bold text-deep-teal">Mon carnet de réservations</h2>
          <span id="bookings-progress" class="text-xs font-semibold text-slate uppercase tracking-wide">0 / 0</span>
        </div>
        <p class="text-sm text-slate mb-4">Coche au fur et à mesure de tes réservations. Tu peux noter ta référence et un mémo.</p>
        <div class="h-2 bg-cream rounded-full overflow-hidden mb-5">
          <div id="bookings-bar" class="h-full bg-amber transition-all duration-300" style="width: 0%"></div>
        </div>
        <ul id="bookings-list" class="space-y-2"></ul>
      </section>

      <!-- Budget consolidé -->
      <section class="bg-deep-teal text-white rounded-2xl p-6 md:p-8">
        <h2 class="font-display text-xl font-bold mb-5">Budget total estimé</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <div>
            <p class="text-amber text-xs font-semibold uppercase tracking-wide mb-1">Logement</p>
            <p class="text-2xl font-display font-bold">~<span id="b-logement">0</span> €</p>
            <p class="text-xs text-white/60"><span id="b-nights">0</span> nuits</p>
          </div>
          <div>
            <p class="text-amber text-xs font-semibold uppercase tracking-wide mb-1">Vol</p>
            <p class="text-2xl font-display font-bold">~<span id="b-flight">0</span> €</p>
            <p class="text-xs text-white/60"><span id="b-flight-pax">0</span> adultes</p>
          </div>
          <div>
            <p class="text-amber text-xs font-semibold uppercase tracking-wide mb-1">Voiture</p>
            <p class="text-2xl font-display font-bold">~<span id="b-car">0</span> €</p>
            <p class="text-xs text-white/60"><span id="b-days">0</span> jours</p>
          </div>
        </div>
        <div class="border-t border-white/15 pt-5 flex flex-col md:flex-row md:items-end justify-between gap-3">
          <div>
            <p class="text-amber text-xs font-semibold uppercase tracking-wide mb-1">Total estimé</p>
            <p class="text-4xl md:text-5xl font-display font-bold">~<span id="b-total">0</span> €</p>
          </div>
          <p class="text-xs text-white/60 max-w-xs md:text-right">
            Estimation indicative hors activités, restaurants et carburant.
            Les prix réels dépendent de la saison et de tes choix.
          </p>
        </div>
      </section>

      <!-- Actions -->
      <section class="bg-white rounded-2xl border border-cream shadow-sm p-6 md:p-8">
        <h2 class="font-display text-xl font-bold text-deep-teal mb-2">Garde ton voyage à portée de main</h2>
        <p class="text-sm text-slate mb-5">Reçois le récap complet par email pour pouvoir le retrouver plus tard.</p>
        <button id="email-btn" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 rounded-full bg-amber text-charcoal font-bold hover:bg-deep-teal hover:text-white transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Recevoir par email
        </button>
      </section>

      <div class="flex flex-col-reverse md:flex-row gap-3 justify-between">
        <a href="/voyage/transport" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border-2 border-deep-teal text-deep-teal font-semibold hover:bg-deep-teal hover:text-white transition-all">
          ← Modifier le transport
        </a>
        <a href="/voyage/destination" class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm text-slate hover:text-deep-teal transition-colors">
          Recommencer un nouveau voyage
        </a>
      </div>
    </div>
  </div>

  <!-- Email dialog -->
  <div id="email-dialog" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 md:p-8 max-w-md w-full">
      <div class="flex items-start justify-between mb-4">
        <h3 class="font-display text-xl font-bold text-deep-teal">Recevoir mon voyage par email</h3>
        <button class="close-dialog text-slate hover:text-deep-teal" aria-label="Fermer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <p class="text-sm text-slate mb-4">On t'envoie le récap complet par email pour pouvoir le retrouver plus tard.</p>
      <form id="email-form" class="space-y-3">
        <input id="email-input" type="email" required placeholder="ton@email.com" class="w-full px-4 py-3 rounded-xl border-2 border-cream bg-white text-charcoal focus:border-amber focus:outline-none transition-colors" />
        <button type="submit" id="email-submit" class="w-full px-6 py-3 rounded-full bg-deep-teal text-white font-bold hover:bg-amber hover:text-charcoal transition-all disabled:opacity-50 disabled:cursor-not-allowed">
          Envoyer
        </button>
      </form>
      <p id="email-feedback" class="text-sm mt-3 hidden"></p>
    </div>
  </div>

  <script type="application/json" id="lieux-data" set:html={JSON.stringify(lieuxData)}></script>

  <script>
    import L from 'leaflet';
    import { loadTrip, saveTrip, shareUrl, type ItineraryStep, type BookingStatus } from '../../lib/tripState';
    import {
      adultsFromComposition, estimateNightlyPrice,
      computeStepDates, formatDateFr,
      countriesData,
    } from '../../lib/affiliates';

    type Lieu = {
      slug: string; title: string; country: string; region: string; type: string;
      image: string; description: string; lat: number; lng: number;
      interests: string[]; duree: number; nuits: boolean;
    };

    const trip = loadTrip();

    if (!trip.country || !trip.itinerary.length) {
      document.getElementById('no-trip')!.classList.remove('hidden');
    } else {
      document.getElementById('recap-content')!.classList.remove('hidden');
      render();
    }

    function bookingItems(enriched: Array<{step: ItineraryStep; lieu: Lieu}>, data: any) {
      const items: Array<{ id: string; icon: string; label: string }> = [];
      // Vol
      items.push({
        id: 'flight',
        icon: '✈',
        label: `Vol aller-retour ${trip.departureCity ?? ''} ${data?.mainCity ? '→ ' + data.mainCity : ''}`.trim(),
      });
      // Voiture (sauf si non pertinent — pour Japon par ex. le train est privilégié,
      // mais on garde l'item car certains en prennent quand même une)
      items.push({
        id: 'car',
        icon: '🚗',
        label: `Voiture${data?.mainCity ? ' à ' + data.mainCity : ''}`,
      });
      // Train si pertinent
      if (data?.trainRelevant) {
        items.push({ id: 'train', icon: '🚆', label: 'Train (Trainline)' });
      }
      // Un logement par lieu où l'on dort
      for (const e of enriched.filter(e => e.lieu.nuits)) {
        items.push({
          id: `lodging-${e.step.id}`,
          icon: '🛏',
          label: `Logement à ${e.lieu.title} (${e.step.days} nuit${e.step.days > 1 ? 's' : ''})`,
        });
      }
      return items;
    }

    function renderBookings(enriched: Array<{step: ItineraryStep; lieu: Lieu}>, data: any) {
      const items = bookingItems(enriched, data);
      const bookings = trip.bookings || {};
      const listEl = document.getElementById('bookings-list')!;

      listEl.innerHTML = items.map(it => {
        const b = bookings[it.id] || { booked: false };
        return `
          <li class="rounded-xl border border-cream ${b.booked ? 'bg-amber/5 border-amber/40' : 'bg-cream/30'} transition-colors" data-booking-id="${it.id}">
            <label class="flex items-center gap-3 px-4 py-3 cursor-pointer">
              <input type="checkbox" class="booking-cb w-5 h-5 rounded accent-amber flex-shrink-0" ${b.booked ? 'checked' : ''} />
              <span class="text-xl flex-shrink-0">${it.icon}</span>
              <span class="flex-1 text-sm font-semibold ${b.booked ? 'text-deep-teal' : 'text-charcoal'}">${it.label}</span>
              ${b.booked ? '<span class="text-xs font-bold text-amber uppercase tracking-wide">Réservé</span>' : ''}
            </label>
            <div class="booking-details ${b.booked ? '' : 'hidden'} px-4 pb-3 pt-1 space-y-2 border-t border-amber/20">
              <input type="text" class="booking-ref w-full px-3 py-2 rounded-lg border border-cream bg-white text-sm focus:border-amber focus:outline-none" placeholder="Référence / numéro de réservation (optionnel)" value="${b.reference ? b.reference.replace(/"/g, '&quot;') : ''}" />
              <textarea class="booking-notes w-full px-3 py-2 rounded-lg border border-cream bg-white text-sm focus:border-amber focus:outline-none resize-none" rows="2" placeholder="Notes (heure d'arrivée, parking, contact...)">${b.notes || ''}</textarea>
            </div>
          </li>
        `;
      }).join('');

      const total = items.length;
      const done = items.filter(it => bookings[it.id]?.booked).length;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      document.getElementById('bookings-progress')!.textContent = `${done} / ${total} réservés`;
      document.getElementById('bookings-bar')!.style.width = `${pct}%`;

      // Event handlers
      listEl.querySelectorAll<HTMLLIElement>('li').forEach(li => {
        const id = li.dataset.bookingId!;
        const cb = li.querySelector<HTMLInputElement>('.booking-cb')!;
        const ref = li.querySelector<HTMLInputElement>('.booking-ref')!;
        const notes = li.querySelector<HTMLTextAreaElement>('.booking-notes')!;

        cb.addEventListener('change', () => {
          const current = trip.bookings[id] || { booked: false };
          trip.bookings = {
            ...trip.bookings,
            [id]: {
              ...current,
              booked: cb.checked,
              bookedAt: cb.checked ? Date.now() : undefined,
            },
          };
          saveTrip({ bookings: trip.bookings });
          renderBookings(enriched, data);
        });

        const saveRefNotes = () => {
          const current = trip.bookings[id] || { booked: false };
          trip.bookings = {
            ...trip.bookings,
            [id]: { ...current, reference: ref.value || undefined, notes: notes.value || undefined },
          };
          saveTrip({ bookings: trip.bookings });
        };
        ref.addEventListener('change', saveRefNotes);
        notes.addEventListener('change', saveRefNotes);
      });
    }

    function render() {
      const lieuxAll: Lieu[] = JSON.parse(document.getElementById('lieux-data')!.textContent || '[]');
      const data = countriesData[trip.country!];
      const adults = adultsFromComposition(trip.composition);
      const nightly = estimateNightlyPrice(trip.country, trip.composition);
      const totalDays = trip.itinerary.reduce((sum, s) => sum + s.days, 0);
      const dates = trip.startDate ? computeStepDates(trip.startDate, trip.itinerary) : null;

      // Header
      const countryName = data?.mainCity ? trip.country!.charAt(0).toUpperCase() + trip.country!.slice(1) : trip.country!;
      document.getElementById('recap-title')!.textContent = `Ton voyage en ${countryName}`;
      const subtitleParts = [`${totalDays} jours`, `${adults} adulte${adults > 1 ? 's' : ''}`];
      if (trip.startDate) {
        const end = new Date(trip.startDate + 'T00:00:00');
        end.setDate(end.getDate() + totalDays);
        subtitleParts.push(`Du ${formatDateFr(trip.startDate)} au ${formatDateFr(end.toISOString().slice(0, 10))}`);
      }
      document.getElementById('recap-subtitle')!.textContent = subtitleParts.join(' · ');

      // Steps list
      const stepsEl = document.getElementById('recap-steps')!;
      const enriched = trip.itinerary.map(s => {
        const lieu = lieuxAll.find(l => l.slug === s.slug);
        return lieu ? { step: s, lieu } : null;
      }).filter(Boolean) as Array<{ step: ItineraryStep; lieu: Lieu }>;

      stepsEl.innerHTML = enriched.map((e, i) => {
        const stepDates = dates?.get(e.step.id);
        const dateLabel = stepDates ? `${formatDateFr(stepDates.checkin)} → ${formatDateFr(stepDates.checkout)}` : '';
        return `
          <li class="flex items-center gap-3 p-3 rounded-xl bg-cream/40 border border-cream">
            <span class="w-7 h-7 rounded-full bg-amber text-charcoal text-xs font-bold flex items-center justify-center flex-shrink-0">${i + 1}</span>
            <img src="${e.lieu.image}" alt="" class="w-10 h-10 rounded-full object-cover flex-shrink-0" />
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-deep-teal text-sm">${e.lieu.title}</div>
              <div class="text-xs text-slate">${e.lieu.type} · ${e.lieu.region}</div>
            </div>
            <div class="text-right flex-shrink-0">
              <div class="text-xs font-bold text-deep-teal">${e.step.days}j ${e.lieu.nuits ? '🛏' : '✦'}</div>
              ${dateLabel ? `<div class="text-[10px] text-slate">${dateLabel}</div>` : ''}
            </div>
          </li>
        `;
      }).join('');

      // Budget
      const totalNights = enriched.filter(e => e.lieu.nuits).reduce((s, e) => s + e.step.days, 0);
      const bLogement = totalNights * nightly;
      const bFlight = data ? data.flightPerAdult * adults : 0;
      const bCar = data ? data.carPerDay * totalDays : 0;
      const bTotal = bLogement + bFlight + bCar;

      document.getElementById('b-logement')!.textContent = bLogement.toLocaleString('fr-FR');
      document.getElementById('b-nights')!.textContent = String(totalNights);
      document.getElementById('b-flight')!.textContent = bFlight.toLocaleString('fr-FR');
      document.getElementById('b-flight-pax')!.textContent = String(adults);
      document.getElementById('b-car')!.textContent = bCar.toLocaleString('fr-FR');
      document.getElementById('b-days')!.textContent = String(totalDays);
      document.getElementById('b-total')!.textContent = bTotal.toLocaleString('fr-FR');

      // Bookings checklist
      renderBookings(enriched, data);

      // Map
      const lats = enriched.map(e => e.lieu.lat);
      const lngs = enriched.map(e => e.lieu.lng);
      const map = L.map('map', {
        scrollWheelZoom: false,
        zoomControl: true,
      });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap',
        maxZoom: 18,
      }).addTo(map);

      enriched.forEach((e, i) => {
        const icon = L.divIcon({
          className: 'recap-marker',
          html: `<div class="recap-pin"><span>${i + 1}</span></div>`,
          iconSize: [30, 38],
          iconAnchor: [15, 36],
        });
        L.marker([e.lieu.lat, e.lieu.lng], { icon }).addTo(map);
      });

      L.polyline(enriched.map(e => [e.lieu.lat, e.lieu.lng] as [number, number]),
        { color: '#D4A03C', weight: 3, opacity: 0.85, dashArray: '6 8' }
      ).addTo(map);

      if (lats.length === 1) {
        map.setView([lats[0], lngs[0]], 7);
      } else {
        const bounds = L.latLngBounds(enriched.map(e => [e.lieu.lat, e.lieu.lng] as [number, number]));
        map.fitBounds(bounds, { padding: [40, 40] });
      }

      // Email
      const emailBtn = document.getElementById('email-btn')!;
      const emailDialog = document.getElementById('email-dialog')!;
      const emailForm = document.getElementById('email-form') as HTMLFormElement;
      const emailInput = document.getElementById('email-input') as HTMLInputElement;
      const emailSubmit = document.getElementById('email-submit') as HTMLButtonElement;
      const emailFeedback = document.getElementById('email-feedback')!;
      emailBtn.addEventListener('click', () => {
        emailDialog.classList.remove('hidden');
        emailFeedback.classList.add('hidden');
      });
      emailForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        emailSubmit.disabled = true;
        emailFeedback.classList.add('hidden');
        try {
          const resp = await fetch('/api/send-recap', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: emailInput.value,
              trip,
              shareLink: shareUrl(trip, '/voyage/recap'),
            }),
          });
          if (resp.ok) {
            emailFeedback.textContent = '✓ Voyage envoyé ! Vérifie ta boîte mail.';
            emailFeedback.className = 'text-sm mt-3 text-green-600';
            emailFeedback.classList.remove('hidden');
            emailInput.value = '';
          } else {
            const err = await resp.json().catch(() => ({}));
            throw new Error(err.error || 'Envoi impossible pour le moment.');
          }
        } catch (err: any) {
          emailFeedback.textContent = `⚠ ${err.message || 'Une erreur est survenue.'}`;
          emailFeedback.className = 'text-sm mt-3 text-red-600';
          emailFeedback.classList.remove('hidden');
        } finally {
          emailSubmit.disabled = false;
        }
      });

      // Close dialog
      document.querySelectorAll('.close-dialog').forEach(btn => {
        btn.addEventListener('click', () => emailDialog.classList.add('hidden'));
      });
      emailDialog.addEventListener('click', e => {
        if (e.target === emailDialog) emailDialog.classList.add('hidden');
      });
    }
  </script>

  <style is:global>
    .recap-marker { background: transparent; border: none; }
    .recap-pin {
      width: 30px; height: 30px;
      border-radius: 50% 50% 50% 0;
      background: #D4A03C;
      border: 3px solid #ffffff;
      transform: rotate(-45deg);
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
      display: flex; align-items: center; justify-content: center;
    }
    .recap-pin span {
      transform: rotate(45deg);
      color: #2D2D2D; font-weight: 800; font-size: 13px;
    }
  </style>
</FunnelLayout>

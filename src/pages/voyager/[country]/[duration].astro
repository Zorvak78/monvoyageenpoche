---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Newsletter from '../../../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';

const allItineraires = await getCollection('itineraires');

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const allItineraires = await getCollection('itineraires');

  return allItineraires.map((item) => ({
    params: {
      country: item.data.country,
      duration: item.data.duration,
    },
    props: {
      itineraire: item,
    },
  }));
}

const { itineraire } = Astro.props;
const { country, duration } = Astro.params;
const { Content } = await render(itineraire);

const countryNames: Record<string, string> = {
  perou: 'Pérou',
  italie: 'Italie du Sud',
  namibie: 'Namibie',
};

// Other durations for this country
const otherDurations = allItineraires.filter(
  (i) => i.data.country === country && i.data.duration !== duration
);
---

<BaseLayout
  title={`${itineraire.data.title} — Mon Voyage en Poche`}
  description={itineraire.data.description}
  ogImage={itineraire.data.heroImage}
>
  <Header />

  <!-- Hero plein écran -->
  <section class="relative min-h-[70vh] flex items-end overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={itineraire.data.heroImage}
        alt={itineraire.data.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/40 to-transparent"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 pt-32 w-full">
      <span class="inline-block px-3 py-1 bg-amber text-white text-sm font-semibold rounded-full mb-4">
        {itineraire.data.durationLabel} — {itineraire.data.days} jours
      </span>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">
        {itineraire.data.title}
      </h1>
      <p class="text-white/85 text-lg max-w-2xl leading-relaxed">
        {itineraire.data.description}
      </p>
    </div>
  </section>

  <!-- Barre sticky -->
  <div class="sticky top-20 z-40 bg-white/95 backdrop-blur-sm border-b border-cream shadow-sm">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-6 text-sm">
          <div>
            <span class="text-slate">Durée</span>
            <span class="ml-1 font-semibold text-deep-teal">{itineraire.data.days}j</span>
          </div>
          <div class="hidden sm:block">
            <span class="text-slate">Budget</span>
            <span class="ml-1 font-semibold text-deep-teal">{itineraire.data.budget}</span>
          </div>
          <div class="hidden sm:block">
            <span class="text-slate">Période</span>
            <span class="ml-1 font-semibold text-deep-teal">{itineraire.data.bestPeriod}</span>
          </div>
        </div>
        <span id="progress-label" class="text-sm font-semibold text-deep-teal whitespace-nowrap"></span>
      </div>
    </div>
    <div class="h-1 bg-cream">
      <div id="progress-bar" class="h-full bg-amber transition-[width] duration-100 ease-out" style="width: 0%"></div>
    </div>
  </div>

  <!-- Breadcrumb -->
  <nav class="bg-warm-white border-b border-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <ol class="flex items-center gap-2 text-sm text-slate flex-wrap">
        <li><a href="/" class="hover:text-deep-teal transition-colors">Accueil</a></li>
        <li class="text-charcoal/30">/</li>
        <li><a href="/inspiration" class="hover:text-deep-teal transition-colors">Inspiration</a></li>
        <li class="text-charcoal/30">/</li>
        <li><a href={`/voyager/${country}`} class="hover:text-deep-teal transition-colors">{countryNames[country!] || country}</a></li>
        <li class="text-charcoal/30">/</li>
        <li class="text-deep-teal font-medium">{itineraire.data.durationLabel}</li>
      </ol>
    </div>
  </nav>

  <!-- Email Overlay -->
  <div id="email-overlay" class="relative z-30">
    <div class="absolute inset-x-0 top-0 min-h-screen bg-white/80 backdrop-blur-sm flex items-start justify-center pt-24 sm:pt-32">
      <div class="max-w-md mx-auto p-8 bg-white rounded-2xl shadow-2xl text-center">
        <h2 class="font-display text-2xl font-bold text-deep-teal mb-2">Accédez à votre itinéraire gratuit</h2>
        <p class="text-slate text-sm mb-6">Entrez votre email pour débloquer l'itinéraire complet.</p>
        <form id="email-form" class="space-y-4">
          <input
            id="email-input"
            type="email"
            required
            placeholder="votre@email.com"
            class="w-full px-4 py-3 border border-cream rounded-xl text-charcoal placeholder:text-slate/50 focus:outline-none focus:ring-2 focus:ring-amber/50 focus:border-amber transition-colors"
          />
          <button type="submit" class="w-full px-6 py-3 bg-amber hover:bg-gold text-white font-semibold rounded-xl transition-colors">
            Découvrir l'itinéraire
          </button>
        </form>
        <p class="text-xs text-slate/60 mt-4">Pas de spam, promis. Vous pouvez vous désinscrire à tout moment.</p>
      </div>
    </div>
  </div>

  <!-- Contenu itinéraire -->
  <article id="itinerary-content" class="py-12 bg-warm-white blur-sm pointer-events-none select-none">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="itinerary-content">
        <Content />
      </div>
    </div>
  </article>

  <!-- Autres durées -->
  {otherDurations.length > 0 && (
    <section class="py-12 bg-cream/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display text-2xl font-bold text-deep-teal mb-2">
          Vous préférez un séjour {otherDurations.some(d => d.data.days < itineraire.data.days) ? 'plus court' : ''}{otherDurations.some(d => d.data.days < itineraire.data.days) && otherDurations.some(d => d.data.days > itineraire.data.days) ? ' ou ' : ''}{otherDurations.some(d => d.data.days > itineraire.data.days) ? 'plus long' : ''} ?
        </h2>
        <p class="text-slate mb-8">Découvrez nos autres itinéraires pour {countryNames[country!] || country}.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          {otherDurations.map((other) => (
            <a
              href={`/voyager/${country}/${other.data.duration}`}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white rounded-xl shadow-sm hover:shadow-md border border-cream hover:border-amber/30 transition-all group"
            >
              <span class="font-display font-bold text-deep-teal group-hover:text-amber transition-colors">
                {other.data.durationLabel}
              </span>
              <span class="text-slate text-sm">({other.data.days} jours)</span>
              <svg class="w-4 h-4 text-slate group-hover:text-amber transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Newsletter />
  <Footer />
</BaseLayout>

<style>
  .itinerary-content h2 {
    position: relative;
    padding-left: 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-cream);
    font-family: var(--font-display);
    color: var(--color-deep-teal);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .itinerary-content h2:first-of-type {
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }
  .itinerary-content h2::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2.35rem;
    width: 12px;
    height: 12px;
    background: var(--color-amber);
    border-radius: 50%;
  }
  .itinerary-content h2:first-of-type::before {
    top: 0.35rem;
  }
  /* Timeline line for content under each H2 */
  .itinerary-content h2 ~ p,
  .itinerary-content h2 ~ ul,
  .itinerary-content h2 ~ ol,
  .itinerary-content h2 ~ blockquote,
  .itinerary-content h2 ~ table,
  .itinerary-content h2 ~ h3 {
    padding-left: 2rem;
    border-left: 2px solid var(--color-cream);
    margin-left: 5px;
  }
  .itinerary-content h3 {
    font-family: var(--font-display);
    color: var(--color-deep-blue);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .itinerary-content p {
    line-height: 1.8;
    margin-bottom: 1rem;
    color: var(--color-charcoal);
  }
  .itinerary-content a {
    color: var(--color-amber);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .itinerary-content a:hover { color: var(--color-gold); }
  .itinerary-content strong { color: var(--color-deep-teal); }
  .itinerary-content img {
    border-radius: 0.75rem;
    margin: 2rem 0;
    padding-left: 0 !important;
    border-left: none !important;
    margin-left: 0 !important;
  }
  /* Bon à savoir blockquotes */
  .itinerary-content blockquote {
    background: var(--color-cream);
    border-left: 4px solid var(--color-amber) !important;
    border-radius: 0 0.75rem 0.75rem 0;
    padding: 1rem 1.5rem !important;
    margin: 1.5rem 0 1.5rem 5px !important;
    font-style: normal;
  }
  .itinerary-content blockquote p {
    padding-left: 0 !important;
    border-left: none !important;
    margin-left: 0 !important;
    margin-bottom: 0;
  }
  .itinerary-content blockquote p:first-child::before {
    content: "💡 Bon à savoir — ";
    font-weight: 700;
    color: var(--color-deep-teal);
  }
  /* Tables */
  .itinerary-content table {
    width: 100%;
    border-collapse: collapse;
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 1.5rem 0 1.5rem 5px;
    padding-left: 0 !important;
    border-left: none !important;
  }
  .itinerary-content th {
    background: var(--color-deep-teal);
    color: white;
    padding: 0.75rem 1rem;
    text-align: left;
    font-size: 0.875rem;
  }
  .itinerary-content td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-cream);
    font-size: 0.875rem;
  }
  .itinerary-content tr:last-child td {
    font-weight: 700;
    background: var(--color-cream);
  }
  .itinerary-content ul, .itinerary-content ol {
    margin-bottom: 1rem;
    padding-left: 3.5rem;
  }
  .itinerary-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: var(--color-charcoal);
  }
</style>

<script>
  // Email overlay
  const emailGiven = localStorage.getItem('mvep_email');
  const overlay = document.getElementById('email-overlay');
  const content = document.getElementById('itinerary-content');
  if (emailGiven) {
    overlay?.remove();
    content?.classList.remove('blur-sm', 'pointer-events-none', 'select-none');
  }
  document.getElementById('email-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('email-input') as HTMLInputElement;
    if (input?.value) {
      localStorage.setItem('mvep_email', input.value);
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      content?.classList.remove('blur-sm', 'pointer-events-none', 'select-none');
      setTimeout(() => overlay?.remove(), 500);
    }
  });

  // Progress bar
  const article = document.getElementById('itinerary-content');
  const progressBar = document.getElementById('progress-bar');
  const progressLabel = document.getElementById('progress-label');
  const h2s = article?.querySelectorAll('h2') || [];
  const totalDays = h2s.length;

  window.addEventListener('scroll', () => {
    if (!article || !progressBar) return;
    const rect = article.getBoundingClientRect();
    const articleTop = window.scrollY + rect.top;
    const articleHeight = rect.height;
    const scrollPos = window.scrollY - articleTop;
    const progress = Math.min(Math.max(scrollPos / articleHeight * 100, 0), 100);
    progressBar.style.width = progress + '%';

    if (progressLabel && totalDays > 0) {
      let currentDay = 0;
      h2s.forEach((h2, i) => {
        if (h2.getBoundingClientRect().top < 200) currentDay = i + 1;
      });
      if (currentDay > 0) {
        progressLabel.textContent = 'Jour ' + currentDay + '/' + totalDays;
      }
    }
  });
</script>

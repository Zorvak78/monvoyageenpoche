---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DestinationCard from '../components/DestinationCard.astro';
import BlogCard from '../components/BlogCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const destinations = (await getCollection('destinations')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const blogPosts = (await getCollection('blog')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 3);

const categories = [
  { name: 'Aventure', icon: '🏔️', desc: 'Treks, randonnées et sensations fortes' },
  { name: 'Culture', icon: '🏛️', desc: 'Temples, musées et traditions' },
  { name: 'Détente', icon: '🏖️', desc: 'Plages, spas et farniente' },
  { name: 'Nature', icon: '🌿', desc: 'Parcs, safaris et grands espaces' },
  { name: 'Road Trip', icon: '🚗', desc: 'Routes mythiques et liberté' },
  { name: 'Gastronomie', icon: '🍜', desc: 'Saveurs locales et street food' },
];
---

<BaseLayout title="Mon Voyage en Poche — Guides de voyage et itinéraires">
  <Header transparent />

  <!-- Hero -->
  <section class="relative h-screen min-h-[600px] flex items-center justify-center">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=1920&q=80"
        alt="Plage tropicale avec eau turquoise"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/60" />
    </div>
    <div class="relative text-center px-4 max-w-4xl">
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
        Mon Voyage en Poche
      </h1>
      <p class="text-white/90 text-lg sm:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
        Des itinéraires détaillés, des bons plans testés et des guides authentiques pour voyager en toute sérénité.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/destinations" class="px-8 py-4 bg-amber hover:bg-gold text-white font-semibold rounded-xl transition-all duration-300 transform hover:scale-105">
          Explorer les destinations
        </a>
        <a href="/blog" class="px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-semibold rounded-xl hover:bg-white/20 transition-all duration-300">
          Lire le blog
        </a>
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 fade-in">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-deep-teal mb-4">
          Quel type de voyage vous inspire ?
        </h2>
        <p class="text-slate text-lg max-w-2xl mx-auto">
          Trouvez l'aventure qui vous correspond parmi nos catégories.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 fade-in">
        {categories.map(cat => (
          <a href={`/destinations?cat=${cat.name.toLowerCase()}`} class="group text-center p-6 rounded-2xl bg-warm-white hover:bg-cream transition-all duration-300 hover:shadow-md">
            <div class="text-4xl mb-3 group-hover:scale-110 transition-transform duration-300">{cat.icon}</div>
            <h3 class="font-semibold text-deep-teal text-sm mb-1">{cat.name}</h3>
            <p class="text-slate text-xs hidden sm:block">{cat.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Popular Destinations -->
  <section class="py-20 bg-warm-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-14 fade-in">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-deep-teal mb-4">
            Destinations populaires
          </h2>
          <p class="text-slate text-lg">
            Nos itinéraires les plus appréciés, prêts à être suivis.
          </p>
        </div>
        <a href="/destinations" class="hidden sm:inline-flex items-center gap-2 text-deep-teal hover:text-amber font-medium transition-colors">
          Tout voir
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 fade-in">
        {destinations.map(dest => (
          <DestinationCard
            title={dest.data.title}
            country={dest.data.country}
            slug={dest.id}
            heroImage={dest.data.heroImage}
            duration={dest.data.duration}
            description={dest.data.description}
            categories={dest.data.categories}
          />
        ))}
      </div>
      <div class="text-center mt-10 sm:hidden">
        <a href="/destinations" class="text-deep-teal hover:text-amber font-medium transition-colors">
          Voir toutes les destinations →
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-14 fade-in">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-deep-teal mb-4">
            Derniers articles
          </h2>
          <p class="text-slate text-lg">
            Conseils, récits et inspirations pour vos prochains voyages.
          </p>
        </div>
        <a href="/blog" class="hidden sm:inline-flex items-center gap-2 text-deep-teal hover:text-amber font-medium transition-colors">
          Tous les articles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 fade-in">
        {blogPosts.map(post => (
          <BlogCard
            title={post.data.title}
            slug={post.id}
            heroImage={post.data.heroImage}
            description={post.data.description}
            publishDate={post.data.publishDate}
            tags={post.data.tags}
            author={post.data.author}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <Newsletter />

  <Footer />
</BaseLayout>

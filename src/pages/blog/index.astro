---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<BaseLayout title="Blog — Mon Voyage en Poche" description="Conseils de voyage, récits d'aventure et guides pratiques pour préparer vos prochains voyages.">
  <Header />

  <!-- Hero -->
  <section class="relative pt-32 pb-20 bg-deep-teal">
    <div class="absolute inset-0 opacity-20">
      <img
        src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=1920&q=80"
        alt="Paysage de voyage"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-4">Le Blog</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">
        Conseils pratiques, récits de voyage et inspirations pour votre prochaine aventure.
      </p>
    </div>
  </section>

  <!-- Tags -->
  <section class="bg-white border-b border-cream sticky top-20 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap gap-3 justify-center" id="tag-filters">
        <button class="tag-btn active px-4 py-2 rounded-full text-sm font-medium bg-deep-teal text-white transition-all" data-tag="all">
          Tous
        </button>
        {allTags.map(tag => (
          <button class="tag-btn px-4 py-2 rounded-full text-sm font-medium bg-cream text-slate hover:bg-sage hover:text-white transition-all" data-tag={tag.toLowerCase()}>
            {tag}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="py-16 bg-warm-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="posts-grid">
        {posts.map(post => (
          <div class="blog-item fade-in" data-tags={post.data.tags.map(t => t.toLowerCase()).join(',')}>
            <BlogCard
              title={post.data.title}
              slug={post.id}
              heroImage={post.data.heroImage}
              description={post.data.description}
              publishDate={post.data.publishDate}
              tags={post.data.tags}
              author={post.data.author}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
  <Footer />

  <script>
    document.querySelectorAll('.tag-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tag-btn').forEach(b => {
          b.classList.remove('active', 'bg-deep-teal', 'text-white');
          b.classList.add('bg-cream', 'text-slate');
        });
        btn.classList.add('active', 'bg-deep-teal', 'text-white');
        btn.classList.remove('bg-cream', 'text-slate');

        const tag = btn.getAttribute('data-tag');
        document.querySelectorAll('.blog-item').forEach(item => {
          const el = item as HTMLElement;
          if (tag === 'all' || el.dataset.tags?.includes(tag || '')) {
            el.style.display = '';
          } else {
            el.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const destinations = (await getCollection('destinations')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const allCategories = [...new Set(destinations.flatMap(d => d.data.categories))].sort();
---

<BaseLayout title="Destinations — Mon Voyage en Poche" description="Découvrez tous nos itinéraires de voyage détaillés. Du Japon au Pérou, de la Namibie à l'Italie.">
  <Header />

  <!-- Hero -->
  <section class="relative pt-32 pb-20 bg-deep-teal">
    <div class="absolute inset-0 opacity-20">
      <img
        src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1920&q=80"
        alt="Route panoramique"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-4">Nos Destinations</h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">
        Chaque itinéraire est détaillé jour par jour, avec nos hébergements et activités recommandés.
      </p>
    </div>
  </section>

  <!-- Filter -->
  <section class="bg-white border-b border-cream sticky top-20 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap gap-3 justify-center" id="category-filters">
        <button class="filter-btn active px-4 py-2 rounded-full text-sm font-medium bg-deep-teal text-white transition-all" data-cat="all">
          Toutes
        </button>
        {allCategories.map(cat => (
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-cream text-slate hover:bg-sage hover:text-white transition-all" data-cat={cat.toLowerCase()}>
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Destinations Grid -->
  <section class="py-16 bg-warm-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="destinations-grid">
        {destinations.map(dest => (
          <div class="destination-item fade-in" data-categories={dest.data.categories.map(c => c.toLowerCase()).join(',')}>
            <DestinationCard
              title={dest.data.title}
              country={dest.data.country}
              slug={dest.id}
              heroImage={dest.data.heroImage}
              duration={dest.data.duration}
              description={dest.data.description}
              categories={dest.data.categories}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
  <Footer />

  <script>
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => {
          b.classList.remove('active', 'bg-deep-teal', 'text-white');
          b.classList.add('bg-cream', 'text-slate');
        });
        btn.classList.add('active', 'bg-deep-teal', 'text-white');
        btn.classList.remove('bg-cream', 'text-slate');

        const cat = btn.getAttribute('data-cat');
        document.querySelectorAll('.destination-item').forEach(item => {
          const el = item as HTMLElement;
          if (cat === 'all' || el.dataset.categories?.includes(cat || '')) {
            el.style.display = '';
          } else {
            el.style.display = 'none';
          }
        });
      });
    });

    // Check URL params
    const params = new URLSearchParams(window.location.search);
    const catParam = params.get('cat');
    if (catParam) {
      const btn = document.querySelector(`[data-cat="${catParam}"]`) as HTMLElement;
      btn?.click();
    }
  </script>
</BaseLayout>

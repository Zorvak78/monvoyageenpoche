---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  return destinations.map(dest => ({
    params: { slug: dest.id },
    props: { dest },
  }));
}

const { dest } = Astro.props;
const { Content } = await render(dest);

const allDestinations = await getCollection('destinations');
const otherDestinations = allDestinations.filter(d => d.id !== dest.id).slice(0, 3);

const infoPratiques = [
  { label: 'Meilleure période', value: dest.data.bestPeriod, icon: '📅' },
  { label: 'Budget moyen', value: dest.data.budget, icon: '💰' },
  { label: 'Durée recommandée', value: dest.data.duration, icon: '⏱️' },
  { label: 'Décalage horaire', value: dest.data.timezone, icon: '🕐' },
  { label: 'Langue', value: dest.data.language, icon: '💬' },
  { label: 'Monnaie', value: dest.data.currency, icon: '💱' },
].filter(i => i.value);
---

<BaseLayout
  title={`${dest.data.title} — Mon Voyage en Poche`}
  description={dest.data.description}
  ogImage={dest.data.heroImage}
  ogType="article"
>
  <Header transparent />

  <!-- Hero -->
  <section class="relative h-[70vh] min-h-[500px] flex items-end">
    <div class="absolute inset-0">
      <img
        src={dest.data.heroImage}
        alt={dest.data.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 w-full">
      <div class="flex flex-wrap gap-2 mb-4">
        {dest.data.categories.map((cat: string) => (
          <span class="bg-amber/90 text-white text-xs font-semibold px-3 py-1 rounded-full">{cat}</span>
        ))}
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-3">
        {dest.data.title}
      </h1>
      <p class="text-white/80 text-lg max-w-2xl">{dest.data.description}</p>
    </div>
  </section>

  <!-- Infos pratiques -->
  <section class="bg-white border-b border-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
        {infoPratiques.map(info => (
          <div class="text-center">
            <div class="text-2xl mb-2">{info.icon}</div>
            <div class="text-xs text-slate uppercase tracking-wider mb-1">{info.label}</div>
            <div class="font-semibold text-deep-teal text-sm">{info.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose max-w-none">
        <Content />
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <Newsletter variant="compact" />
  </div>

  <!-- Other Destinations -->
  {otherDestinations.length > 0 && (
    <section class="py-16 bg-cream">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display text-3xl font-bold text-deep-teal mb-10 text-center">
          Autres destinations
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {otherDestinations.map(d => (
            <DestinationCard
              title={d.data.title}
              country={d.data.country}
              slug={d.id}
              heroImage={d.data.heroImage}
              duration={d.data.duration}
              description={d.data.description}
              categories={d.data.categories}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

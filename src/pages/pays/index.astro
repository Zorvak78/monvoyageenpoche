---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { countryContent } from '../../data/countryContent';

const countries = Object.values(countryContent);

const title = 'Toutes les destinations | Mon Voyage en Poche';
const description = "Découvre nos destinations : Namibie, Italie, Japon, Pérou. Pour chaque pays, des itinéraires testés, des lieux emblématiques et un planificateur complet.";
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="pt-28 pb-16 min-h-screen bg-warm-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Accueil', href: '/' },
        { label: 'Destinations' },
      ]} />
      <p class="font-display italic text-amber mt-4 mb-2">Inspirations</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-deep-teal mb-3">Toutes les destinations</h1>
      <p class="text-slate text-lg mb-10 max-w-2xl">{description}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {countries.map(c => (
          <a href={`/pays/${c.slug}`} class="block bg-white rounded-2xl border border-cream overflow-hidden hover:border-amber transition-colors group">
            <div class="aspect-[16/9] overflow-hidden bg-cream relative">
              <img src={c.heroImage} alt={c.name} class="w-full h-full object-cover transition-transform group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-4 left-5 text-white">
                <h2 class="font-display text-2xl font-bold">{c.name}</h2>
                <p class="text-sm italic text-amber">{c.tagline}</p>
              </div>
            </div>
            <div class="p-5">
              <p class="text-sm text-slate leading-snug">{c.shortDescription}</p>
              <div class="mt-3 text-sm text-deep-teal font-semibold group-hover:text-amber transition-colors inline-flex items-center gap-1">
                Découvrir
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

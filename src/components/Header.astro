---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
---

<header
  id="main-header"
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-all duration-300',
    transparent ? 'bg-transparent' : 'bg-white shadow-sm'
  ]}
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex items-center gap-2">
        <span class:list={[
          'logo-text font-display text-xl sm:text-2xl font-bold transition-colors duration-300',
          transparent ? 'text-white' : 'text-deep-teal'
        ]}>
          Mon Voyage en Poche
        </span>
      </a>

      <div class="flex items-center gap-3">
        <a
          href="/voyage/destination"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-amber text-charcoal text-sm font-semibold tracking-wide hover:bg-gold hover:text-white transition-all"
        >
          Commencer mon voyage
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </nav>
</header>

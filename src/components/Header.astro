---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/destinations', label: 'Destinations' },
  { href: '/inspiration', label: 'Inspiration' },
  { href: '/blog', label: 'Blog' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/contact', label: 'Contact' },
];
---

<header
  id="main-header"
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-all duration-300',
    transparent ? 'bg-transparent' : 'bg-white shadow-sm'
  ]}
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <span class:list={[
          'logo-text font-display text-xl sm:text-2xl font-bold transition-colors duration-300',
          transparent ? 'text-white' : 'text-deep-teal'
        ]}>
          Mon Voyage en Poche
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-8">
        {links.map(link => (
          <a
            href={link.href}
            class:list={[
              'nav-link text-sm font-medium tracking-wide uppercase transition-colors duration-300 hover:text-amber',
              transparent ? 'text-white' : 'text-charcoal',
              currentPath === link.href ? 'border-b-2 border-amber pb-1' : ''
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2"
        aria-label="Menu"
      >
        <svg class:list={['w-6 h-6', transparent ? 'text-white' : 'text-charcoal']} fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      {links.map(link => (
        <a
          href={link.href}
          class:list={[
            'block py-3 px-4 text-sm font-medium tracking-wide uppercase transition-colors hover:text-amber hover:bg-cream rounded-lg',
            currentPath === link.href ? 'text-amber' : 'text-charcoal'
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const header = document.getElementById('main-header');
    if (!menu?.classList.contains('hidden')) {
      header?.classList.add('bg-white', 'shadow-sm');
      header?.classList.remove('bg-transparent');
    }
  });
</script>

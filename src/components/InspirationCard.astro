---
interface Props {
  title: string;
  location: string;
  type: string;
  image: string;
  description: string;
  destinationLink: string;
}

const { title, location, type, image, description, destinationLink } = Astro.props;
---

<a href={destinationLink} class="group block">
  <article class="relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 transform hover:-translate-y-1">
    <div class="relative h-72 overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
      <div class="absolute top-4 left-4">
        <span class="bg-amber/90 text-white text-xs font-semibold px-3 py-1 rounded-full">
          {type}
        </span>
      </div>
      <div class="absolute bottom-4 left-4 right-4">
        <h3 class="text-white font-display text-xl font-bold mb-1 group-hover:text-amber transition-colors">
          {title}
        </h3>
        <p class="text-white/80 text-sm">{location}</p>
      </div>
    </div>
    <div class="p-5">
      <p class="text-slate text-sm leading-relaxed line-clamp-3">{description}</p>
      <div class="mt-3 flex items-center text-deep-teal text-sm font-medium group-hover:text-amber transition-colors">
        Voir l'itinéraire
        <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </article>
</a>

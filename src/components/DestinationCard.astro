---
interface Props {
  title: string;
  country: string;
  slug: string;
  heroImage: string;
  duration: string;
  description: string;
  categories: string[];
}

const { title, country, slug, heroImage, duration, description, categories } = Astro.props;
---

<a href={`/destinations/${slug}`} class="group block">
  <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 transform hover:-translate-y-1">
    <div class="relative h-64 overflow-hidden">
      <img
        src={heroImage}
        alt={`Voyage ${title}`}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent" />
      <div class="absolute bottom-4 left-4 right-4">
        <span class="text-white/80 text-sm font-medium">{country}</span>
        <h3 class="text-white font-display text-xl font-bold">{title}</h3>
      </div>
      <div class="absolute top-4 right-4">
        <span class="bg-white/90 backdrop-blur-sm text-deep-teal text-xs font-semibold px-3 py-1.5 rounded-full">
          {duration}
        </span>
      </div>
    </div>
    <div class="p-5">
      <p class="text-slate text-sm leading-relaxed line-clamp-2 mb-3">{description}</p>
      <div class="flex flex-wrap gap-2">
        {categories.slice(0, 3).map(cat => (
          <span class="text-xs bg-cream text-sage px-2.5 py-1 rounded-full">{cat}</span>
        ))}
      </div>
    </div>
  </article>
</a>

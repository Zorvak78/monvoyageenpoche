---
const year = new Date().getFullYear();
---

<footer class="bg-deep-blue text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <h3 class="font-display text-2xl font-bold mb-4">Mon Voyage en Poche</h3>
        <p class="text-white/70 text-sm leading-relaxed">
          Des guides de voyage authentiques, des itinéraires testés et des bons plans pour explorer le monde autrement.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="font-semibold text-amber mb-4 uppercase text-sm tracking-wider">Explorer</h4>
        <ul class="space-y-3">
          <li><a href="/destinations" class="text-white/70 hover:text-amber transition-colors text-sm">Destinations</a></li>
          <li><a href="/blog" class="text-white/70 hover:text-amber transition-colors text-sm">Blog</a></li>
          <li><a href="/a-propos" class="text-white/70 hover:text-amber transition-colors text-sm">À propos</a></li>
          <li><a href="/contact" class="text-white/70 hover:text-amber transition-colors text-sm">Contact</a></li>
        </ul>
      </div>

      <!-- Destinations -->
      <div>
        <h4 class="font-semibold text-amber mb-4 uppercase text-sm tracking-wider">Destinations</h4>
        <ul class="space-y-3">
          <li><a href="/destinations/japon" class="text-white/70 hover:text-amber transition-colors text-sm">Japon</a></li>
          <li><a href="/destinations/perou" class="text-white/70 hover:text-amber transition-colors text-sm">Pérou</a></li>
          <li><a href="/destinations/namibie" class="text-white/70 hover:text-amber transition-colors text-sm">Namibie</a></li>
          <li><a href="/destinations/italie" class="text-white/70 hover:text-amber transition-colors text-sm">Italie</a></li>
          <li><a href="/destinations/guadeloupe" class="text-white/70 hover:text-amber transition-colors text-sm">Guadeloupe</a></li>
          <li><a href="/destinations/egypte" class="text-white/70 hover:text-amber transition-colors text-sm">Égypte</a></li>
        </ul>
      </div>

      <!-- Social & Legal -->
      <div>
        <h4 class="font-semibold text-amber mb-4 uppercase text-sm tracking-wider">Suivez-nous</h4>

---
interface Props {
  variant?: 'default' | 'compact';
}
const { variant = 'default' } = Astro.props;
---

{variant === 'default' ? (
  <section class="bg-deep-teal py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-white mb-4">
        Prêt à partir ?
      </h2>
      <p class="text-white/80 text-lg mb-8 max-w-2xl mx-auto">
        Recevez nos meilleurs itinéraires, bons plans et inspirations voyage directement dans votre boîte mail. Pas de spam, promis.
      </p>
      <form class="flex flex-col sm:flex-row gap-4 max-w-lg mx-auto" action="#" method="POST">
        <input
          type="email"
          placeholder="votre@email.com"
          required
          class="flex-1 px-5 py-3.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-amber focus:border-transparent"
        />
        <button
          type="submit"
          class="px-8 py-3.5 bg-amber hover:bg-gold text-white font-semibold rounded-xl transition-colors duration-300 whitespace-nowrap"
        >
          S'inscrire
        </button>
      </form>
      <p class="text-white/50 text-xs mt-4">En vous inscrivant, vous acceptez notre politique de confidentialité.</p>
    </div>
  </section>
) : (
  <div class="bg-cream rounded-2xl p-8 text-center">
    <h3 class="font-display text-2xl font-bold text-deep-teal mb-3">Ne manquez rien</h3>
    <p class="text-slate text-sm mb-5">Guides, bons plans et inspirations dans votre boîte mail.</p>
    <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" action="#" method="POST">
      <input
        type="email"
        placeholder="votre@email.com"
        required
        class="flex-1 px-4 py-3 rounded-xl border border-sage/20 focus:outline-none focus:ring-2 focus:ring-amber text-sm"
      />
      <button
        type="submit"
        class="px-6 py-3 bg-deep-teal hover:bg-forest text-white font-semibold rounded-xl transition-colors text-sm"
      >
        S'inscrire
      </button>
    </form>
  </div>
)}
